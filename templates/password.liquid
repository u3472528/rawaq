<section class="password-page page-width page-width--narrow">
  <div class="password-page__inner">
    <h1 class="password-page__heading">{{ 'general.password_page.heading' | t }}</h1>

    {%- form 'storefront_password', class: 'password-form' -%}
      <label for="Password">{{ 'general.password_page.password_label' | t }}</label>
      <div class="password-form__row">
        <input
          type="password"
          name="password"
          id="Password"
          class="field"
          placeholder="{{ 'general.password_page.password_placeholder' | t }}"
          autocomplete="current-password"
          required
        >
        <button type="submit" class="button">{{ 'general.password_page.password_button' | t }}</button>
      </div>
      {%- if form.errors -%}
        <p class="password-form__errors">{{ form.errors | default_errors }}</p>
      {%- endif -%}
    {%- endform -%}

    <p class="password-page__admin">{{ 'general.password_page.admin_link_html' | t }}</p>
  </div>
</section>