[
  {
    "name": "theme_info",
    "theme_name": "Rawaq",
    "theme_version": "1.0.0",
    "theme_author": "Rawaq",
    "theme_documentation_url": "https://shopify.dev/docs/themes",
    "theme_support_url": "https://shopify.dev/docs/themes"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#1a1a1a"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Background",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "color_button",
        "label": "Buttons",
        "default": "#1a1a1a"
      },
      {
        "type": "color",
        "id": "color_button_text",
        "label": "Button text",
        "default": "#ffffff"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "select",
        "id": "page_width",
        "label": "Page width",
        "options": [
          {
            "value": "full",
            "label": "Full width"
          },
          {
            "value": "wide",
            "label": "Wide"
          },
          {
            "value": "narrow",
            "label": "Narrow"
          }
        ],
        "default": "full"
      },
      {
        "type": "header",
        "content": "Animations"
      },
      {
        "type": "checkbox",
        "id": "page_transition_enabled",
        "label": "Enable page transitions",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "transition_to_main_product",
        "label": "Transition to main product",
        "default": false
      },
      {
        "type": "header",
        "content": "Cards"
      },
      {
        "type": "select",
        "id": "card_hover_effect",
        "label": "Card hover effect",
        "options": [
          {
            "value": "none",
            "label": "None"
          },
          {
            "value": "zoom",
            "label": "Zoom"
          },
          {
            "value": "lift",
            "label": "Lift"
          }
        ],
        "default": "none"
      }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Will be scaled down to 32 x 32px"
      }
    ]
  }
]