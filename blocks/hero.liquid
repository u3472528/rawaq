<div class="hero-block" {{ block.shopify_attributes }}>
  {%- if block.settings.kicker != blank -%}
    <p class="hero-block__kicker">{{ block.settings.kicker }}</p>
  {%- endif -%}

  {%- if block.settings.heading != blank -%}
    <h1 class="hero-block__heading">{{ block.settings.heading }}</h1>
  {%- endif -%}

  {%- if block.settings.text != blank -%}
    <div class="hero-block__text">{{ block.settings.text }}</div>
  {%- endif -%}

  {%- if block.settings.button_label != blank -%}
    {% render 'button',
      label: block.settings.button_label,
      href: block.settings.button_link
    %}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Hero content",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    }
  ],
  "presets": [
    {
      "name": "Hero content"
    }
  ]
}
{% endschema %}