<div class="announcements" data-announcements>
  {%- assign announcement_count = 0 -%}
  {%- assign announcement_count = announcement_count | plus: 1 -%}
  <div class="announcement{% if announcement_count == 1 %} is-active{% endif %}" data-announcement {{ block.shopify_attributes }} >
    {%- if block.settings.text_url != blank -%}
      <a href="{{ block.settings.text_url }}">
        {{ block.settings.text }}
      </a>
    {%- else -%}
      <span>{{ block.settings.text }}</span>
    {%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "Announcement",

  "settings": [
    {
      "type": "header",
      "content": "Announcement"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "url",
      "id": "text_url",
      "label": "URL"
    }
  ]
}
{% endschema %}
