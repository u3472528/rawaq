{%- liquid
  assign results_per_page = section.settings.results_per_page
-%}

<section class="main-search page-width">
  <h1 class="main-search__title">{{ 'general.search.title' | t }}</h1>

  {%- form 'search', class: 'search-form' -%}
    <input
      type="search"
      name="q"
      value="{{ search.terms | escape }}"
      placeholder="{{ 'general.search.placeholder' | t }}"
      aria-label="{{ 'general.search.title' | t }}"
    >
    <button type="submit" class="button">{{ 'general.search.submit' | t }}</button>
  {%- endform -%}

  {%- if search.performed -%}
    {%- if search.results.size > 0 -%}
      <p class="main-search__count">{{ 'general.search.results_with_count' | t: count: search.results.size, terms: search.terms }}</p>

      {%- paginate search.results by results_per_page -%}
        <ul class="search-results">
          {%- for result in search.results -%}
            {%- assign result_description = result.content | default: result.description | strip_html | truncatewords: 25 -%}
            <li class="search-results__item">
              <a href="{{ result.url }}" class="search-results__link">
                <span class="search-results__title">{{ result.title }}</span>
                {%- if result_description != blank -%}
                  <span class="search-results__description">{{ result_description }}</span>
                {%- endif -%}
              </a>
            </li>
          {%- endfor -%}
        </ul>

        {%- if paginate.pages > 1 -%}
          <nav class="pagination">
            {%- if paginate.previous -%}
              <a class="pagination__link" href="{{ paginate.previous.url }}">{{ 'general.pagination.previous' | t }}</a>
            {%- endif -%}
            <span class="pagination__current">{{ 'general.pagination.page' | t: number: paginate.current_page, count: paginate.pages }}</span>
            {%- if paginate.next -%}
              <a class="pagination__link" href="{{ paginate.next.url }}">{{ 'general.pagination.next' | t }}</a>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- endpaginate -%}
    {%- else -%}
      <p class="main-search__no-results">{{ 'general.search.no_results' | t: terms: search.terms }}</p>
    {%- endif -%}
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Search",
  "settings": [
    {
      "type": "range",
      "id": "results_per_page",
      "label": "Results per page",
      "min": 6,
      "max": 24,
      "step": 2,
      "default": 10
    }
  ]
}
{% endschema %}