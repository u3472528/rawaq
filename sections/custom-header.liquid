{{ 'custom-header.css' | asset_url | stylesheet_tag }}
<div class="custom-header custom-header-{{ section.id }}">
  <button
    type="button"
    class="menu-drawer-button is-show"
    aria-label="Toggle menu"
    aria-expanded="false"
  >
    <span class="hamburger-line"></span>
  </button>
  <div class="brand-logo"><img src="{{  settings.logo | image_url }}" /></div>
</div>

{% schema %}
{
  "name": "Custom Header",
  "settings": [],
  "enabled_on": {
    "groups": ["header"]
  },
  "presets": [
    {
      "name": "Custom Header"
    }
  ]
}
{% endschema %}
