{{ 'custom-header.css' | asset_url | stylesheet_tag }}
<div class="custom-header custom-header-{{ section.id }}">
  <div class="hamburger-brand-logo">
  <button
    type="button"
    class="menu-drawer-button is-show"
    aria-label="Toggle menu"
    aria-expanded="false"
  >
    <span class="hamburger-line"></span>
  </button>
  <div class="brand-logo"><img src="{{  settings.logo | image_url }}" style="--height:{{ settings.logo_height }}px;" /></div>
</div>
  <div class="search-bar">{%  render 'search-bar' %}</div>
</div>

{% schema %}
{
  "name": "Custom Header",
  "settings": [
    {"type": "header","content": "Menu"},
    {"type": "link_list","id":"menu","label":"Menu"},

  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "presets": [
    {
      "name": "Custom Header"
    }
  ]
}
{% endschema %}
