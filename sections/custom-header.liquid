<div class="custom-header custom-header-{{ section.id }}">
  <button
    type="button"
    class="menu-drawer-button is-show"
    aria-label="Toggle menu"
    aria-expanded="false"
  >
    <span class="hamburger-line"></span>
  </button>
</div>

<style>
  .custom-header-{{ section.id }} .menu-drawer-button {
    position: relative;
    display: inline-block;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: none;
    background: transparent;
    cursor: pointer;
    color: rgb(var(--color-foreground));
  }

  .custom-header-{{ section.id }} .hamburger-line {
    position: absolute;
    top: 50%;
    left: 0.25rem;
    display: block;
    width: 2rem;
    height: 0.2rem;
    margin-top: -0.1rem;
    background-color: rgb(var(--color-foreground));
    border-radius: 1rem;
  }

  .custom-header-{{ section.id }} .hamburger-line::before,
  .custom-header-{{ section.id }} .hamburger-line::after {
    content: "";
    position: absolute;
    left: 0;
    display: block;
    width: 100%;
    height: 0.2rem;
    background-color: rgb(var(--color-foreground));
    border-radius: 1rem;
  }

  .custom-header-{{ section.id }} .hamburger-line::before {
    top: -0.7rem;
  }

  .custom-header-{{ section.id }} .hamburger-line::after {
    bottom: -0.7rem;
  }
</style>

{% schema %}
{
  "name": "Custom Header",
  "settings": [],
  "enabled_on": {
    "groups": ["header"]
  },
  "presets": [
    {
      "name": "Custom Header"
    }
  ]
}
{% endschema %}