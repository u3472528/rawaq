<div class="mitoglow-tabs" id="mitoglow-tabs-{{ section.id }}">

  <div class="mitoglow-tabs__heading">
    <h1>{{ section.settings.heading }}</h1>
    <p class="mitoglow-tabs__description">{{ section.settings.description }}</p>
  </div>


  <div class="mitoglow-tabs__nav">
    {% for block in section.blocks %}
      {% if block.type == 'tab' %}
        <button
          class="mitoglow-tabs__tab"
          type="button"
          data-tab="{{ block.id }}"
          style="--red: #C8362A;"
          {{ block.shopify_attributes }}>
          {% assign tab_parts = block.settings.tab | split: ':' %}
          {{ tab_parts[0] }}{% if tab_parts.size > 1 %}:
            <span>{{ tab_parts[1] }}</span>
          {% endif %}
        </button>
      {% endif %}
    {% endfor %}
  </div>

  <div class="mitoglow-tabs__content">
    {% for block in section.blocks %}
      <div
        class="mitoglow-card"
        data-content="{{ block.id }}"
        style="--red: {{ block.settings.dot_color | default: '#ff3d2e' }}; --border: {{ block.settings.border_color | default: '#f3c9c1' }}; --text: {{ block.settings.text_color | default: '#171717' }};"
        {{ block.shopify_attributes }}>

        {% if block.settings.tab_index_text != blank %}
          <div class="mitoglow-card__mode">
            <span class="mitoglow-card__dot"></span>
            <span>{{ block.settings.tab_index_text }}</span>
          </div>
        {% endif %}

        <h2 class="title">{{ block.settings.tab_title }}</h2>

        <div class="mitoglow-card__details">

          <div>
            <span class="mitoglow-card__label">{{ block.settings.tab_desc_label_1 }}</span>
            <p>{{ block.settings.tab_desc_1 }}</p>
          </div>

          <div>
            <span class="mitoglow-card__label">{{ block.settings.tab_desc_label_2 }}</span>
            <p>{{ block.settings.tab_desc_2 }}</p>
          </div>

        </div>

        {% if block.settings.footer != blank %}
          <div class="mitoglow-card__footer">
            {{ block.settings.footer }}
          </div>
        {% endif %}

      </div>
    {% endfor %}
  </div>
</div>


<style>
  .mitoglow-tabs__heading h1 {
    font-family: var(--sl-font-heading);
    font-weight: 500;
    font-size: clamp(30px, 6vh, 49px);
    line-height: clamp(30px, 6vh, 49px);
    letter-spacing: 0;
    text-align: center;
    vertical-align: middle;
    color: #211A13;
    margin-bottom: 24px;
  }
  .mitoglow-tabs__description {
    font-family: var(--font-geist);
    font-weight: 400;
    font-size: 16px;
    line-height: 100%;
    letter-spacing: 0;
    text-align: center;
    vertical-align: middle;
    color: #4B463F;
    margin-bottom: 32px !important;
  }

  #shopify-section-{{ section.id }} {
    width: calc(100% - 1.25rem);
    background: {{ section.settings.section_background | default: '#f7eee6' }};
    padding-top: {{ section.settings.padding_top_desktop | default: 16 }}px;
    padding-right: {{ section.settings.padding_right_desktop | default: 16 }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop | default: 16 }}px;
    padding-left: {{ section.settings.padding_left_desktop | default: 16 }}px;
  }

  #mitoglow-tabs-{{ section.id }} {
    --red: #ff3d2e;
    --border: #f3c9c1;
    --text: #171717;
    --muted: #6B6860;
    width: 100%;
    box-sizing: border-box;
  }

  #mitoglow-tabs-{{ section.id }}
  .mitoglow-tabs__nav {
    display: flex;
    gap: 8px;
    justify-content: {{ section.settings.tab_alignment | default: 'flex-start' }};
    max-width: {{ section.settings.max_width | default: 1200 }}px;
    margin: 0 auto 36px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  #mitoglow-tabs-{{ section.id }}
  .mitoglow-tabs__nav::-webkit-scrollbar {
    display: none;
  }

  #mitoglow-tabs-{{ section.id }}
  .mitoglow-tabs__tab {
    appearance: none;
    border: 1px solid #d7d0ca;
    background: rgba(255, 255, 255, 0.2);
    color: #99938d;
    border-radius: 4px;
    padding: 12px 16px;
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
    transition: all 0.2s ease;
    font-family: var(--font-geist);
    font-weight: 400;
    font-size: 16px;
    line-height: 100%;
    letter-spacing: 0;
    text-transform: uppercase;

  }

  #mitoglow-tabs-{{ section.id }} .mitoglow-tabs__tab  span {
      font-weight:600;
    }
  
  #mitoglow-tabs-{{ section.id }}.mitoglow-tabs__tab:focus-visible {
    outline: 2px solid var(--red);
    outline-offset: 2px;
  }

  #mitoglow-tabs-{{ section.id }}
  .mitoglow-tabs__tab.is-active {
    border-color: var(--red);
    background: #C8362A33;
    color: var(--red);
  }

  #mitoglow-tabs-{{ section.id }}
  .mitoglow-tabs__content {
    position: relative;
    max-width: {{ section.settings.max_width | default: 1200 }}px;
    margin: 0 auto;
  }

  #mitoglow-tabs-{{ section.id }}
  .mitoglow-card {
    display: none;
    border: 1px solid var(--border);
    border-radius: 13px;
    background: #FCF9F4;
    padding: 32px;
  }

  #mitoglow-tabs-{{ section.id }}
  .mitoglow-card.is-active {
    display: block;
  }

  #mitoglow-tabs-{{ section.id }}
  .mitoglow-card__mode {
    display: flex;
    align-items: center;
    gap: 7px;
    margin-bottom: 11px;
    color: var(--red);
    font-family: var(--font-geist);
    font-weight: 600;
    font-size: 12px;
    line-height: 16px;
    letter-spacing: 0.6px;
    text-transform: uppercase;

  }

  #mitoglow-tabs-{{ section.id }}
  .mitoglow-card__dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--red);
    flex: 0 0 12px;
  }

  #mitoglow-tabs-{{ section.id }}
  .mitoglow-card h2 {
    margin: 0 0 14px;
    color: var(--text);
    font-family: var(--sl-font-heading);
    font-weight: 500;
    font-size: 30px;
    line-height: 36px;
    letter-spacing: 0;
  }

  #mitoglow-tabs-{{ section.id }}
  .mitoglow-card__details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
  }

  #mitoglow-tabs-{{ section.id }}
  .mitoglow-card__label {
    display: block;
    margin-bottom: 4px;
    color: #C8362A;
    font-family: var(--font-geist);
    font-weight: 600;
    font-size: 12px;
    line-height: 16px;
    letter-spacing: 0.6px;
    text-transform: uppercase;

  }

  #mitoglow-tabs-{{ section.id }}
  .mitoglow-card__details p {
    margin: 0;
    color: var(--text);
    font-family: var(--font-geist);
    font-weight: 400;
    font-size: 16px;
    line-height: 100%;
    letter-spacing: 0;

  }

  #mitoglow-tabs-{{ section.id }}
  .mitoglow-card__footer p {
    margin-top: 17px;
    padding-top: 12px;
    border-top: 1px solid #00000024;
    color: var(--muted);
    font-family: var(--font-geist);
    font-weight: 400;
    font-size: 14px;
    line-height: 20px;
    letter-spacing: 0;
    margin-bottom: 0px;

  }

  #mitoglow-tabs-{{ section.id }}
  .mitoglow-card__footer strong {
    color: #0B0B0B;
    /* margin: 0; */
  }

  #mitoglow-tabs-{{ section.id }}.mitoglow-extra-content:empty {
    display: none;
  }

  #mitoglow-tabs-{{ section.id }}
  .mitoglow-extra-content {
    margin-top: 20px;
  }

  @media screen and (max-width: 600px) {

    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile | default: 16 }}px;
      padding-right: {{ section.settings.padding_right_mobile | default: 16 }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile | default: 16 }}px;
      padding-left: {{ section.settings.padding_left_mobile | default: 16 }}px;
    }



    #mitoglow-tabs-{{ section.id }}
    .mitoglow-tabs__description {
      font-size: 14px;
    }

    #mitoglow-tabs-{{ section.id }}
    .mitoglow-tabs__nav {
      margin-bottom: 16px;
      gap: 6px;
    }

    #mitoglow-tabs-{{ section.id }}
    .mitoglow-tabs__tab {
      padding: 8px 12px;
      font-size: 12px;
    }

    #mitoglow-tabs-{{ section.id }}
    .mitoglow-card {
      padding: 20px;
      border-radius: 10px;
    }

    #mitoglow-tabs-{{ section.id }}
    .mitoglow-card h2 {
      font-size: 22px;
      line-height: 28px;
    }

    #mitoglow-tabs-{{ section.id }}
    .mitoglow-card__details {
      grid-template-columns: 1fr;
      gap: 15px;
    }

    #mitoglow-tabs-{{ section.id }}
    .mitoglow-card__details p {
      font-size: 14px;
      line-height: 1.5;
    }

  }
</style>


<script>
  (function () {
    function initMitoglowTabs(root) {
      var section = (root || document).querySelector('#mitoglow-tabs-{{ section.id }}');
      if (!section || section.dataset.mitoglowReady === 'true') return;
      section.dataset.mitoglowReady = 'true';
  
      var tabs = section.querySelectorAll('.mitoglow-tabs__tab');
      var cards = section.querySelectorAll('.mitoglow-card');
  
      function activate(id) {
        tabs.forEach(function (t) {
          t.classList.toggle('is-active', t.dataset.tab === id);
        });
        cards.forEach(function (c) {
          c.classList.toggle('is-active', c.dataset.content === id);
        });
      }
  
      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          activate(tab.dataset.tab);
        });
      });
  
      if (tabs.length) activate(tabs[0].dataset.tab);
    }
  
    initMitoglowTabs(document);
  
    document.addEventListener('shopify:section:load', function (e) {
      initMitoglowTabs(e.target);
    });
  
    document.addEventListener('shopify:block:select', function (e) {
      var tab = document.querySelector('[data-tab="' + e.detail.blockId + '"]');
      if (tab) tab.click();
    });
  })();
</script>


{% schema %}
  {
    "name": "MitoGlow Tabs Section",
    "tag": "section",
    "settings": [
      {
        "type": "header",
        "content": "Heading"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Five Targeted Treatments. One Mask."
      },
      {
        "type": "textarea",
        "id": "description",
        "label": "Description",
        "default": "Each mode activates a specific combination of wavelengths to address your primary skin concern. Sessions are 10 minutes or less."
      },
      {
        "type": "header",
        "content": "Max Width"
      }, {
        "type": "range",
        "id": "max_width",
        "label": "Content max width (px)",
        "min": 0,
        "max": 1000,
        "step": 10,
        "default": 100,
        "unit": "px"
      }, {
        "type": "header",
        "content": "Desktop padding (px)"
      }, {
        "type": "range",
        "id": "padding_top_desktop",
        "label": "Top",
        "min": 0,
        "max": 120,
        "step": 4,
        "default": 16,
        "unit": "px"
      }, {
        "type": "range",
        "id": "padding_bottom_desktop",
        "label": "Bottom",
        "min": 0,
        "max": 120,
        "step": 4,
        "default": 16,
        "unit": "px"
      }, {
        "type": "range",
        "id": "padding_left_desktop",
        "label": "Left",
        "min": 0,
        "max": 120,
        "step": 4,
        "default": 16,
        "unit": "px"
      }, {
        "type": "range",
        "id": "padding_right_desktop",
        "label": "Right",
        "min": 0,
        "max": 120,
        "step": 4,
        "default": 16,
        "unit": "px"
      }, {
        "type": "header",
        "content": "Mobile padding (px)"
      }, {
        "type": "range",
        "id": "padding_top_mobile",
        "label": "Top",
        "min": 0,
        "max": 120,
        "step": 4,
        "default": 16,
        "unit": "px"
      }, {
        "type": "range",
        "id": "padding_bottom_mobile",
        "label": "Bottom",
        "min": 0,
        "max": 120,
        "step": 4,
        "default": 16,
        "unit": "px"
      }, {
        "type": "range",
        "id": "padding_left_mobile",
        "label": "Left",
        "min": 0,
        "max": 120,
        "step": 4,
        "default": 16,
        "unit": "px"
      }, {
        "type": "range",
        "id": "padding_right_mobile",
        "label": "Right",
        "min": 0,
        "max": 120,
        "step": 4,
        "default": 16,
        "unit": "px"
      }, {
        "type": "color",
        "id": "section_background",
        "label": "Section background color",
        "default": "#f7eee6"
      }, {
        "type": "select",
        "id": "tab_alignment",
        "label": "Tab alignment",
        "options": [
          {
            "value": "flex-start",
            "label": "Left"
          }, {
            "value": "center",
            "label": "Center"
          }, {
            "value": "flex-end",
            "label": "Right"
          }
        ],
        "default": "flex-start"
      }
    ],
    "blocks": [
      {
        "type": "tab",
        "name": "Tab With Content",
        "settings": [
          {
            "type": "text",
            "id": "tab",
            "label": "Tab label",
            "default": "MODE 1: Anti-Aging"
          },
          {
            "type": "text",
            "id": "tab_index_text",
            "label": "Index text",
            "default": "630nm Red"
          },
          {
            "type": "text",
            "id": "tab_title",
            "label": "Card title",
            "default": "Mode 01 — Anti-Aging"
          },
          {
            "type": "text",
            "id": "tab_desc_label_1",
            "label": "Card 1st description title",
            "default": "Best for"
          }, {
            "type": "text",
            "id": "tab_desc_1",
            "label": "Card 1st description",
            "default": "Fine lines, firmness, overall skin rejuvenation"
          }, {
            "type": "text",
            "id": "tab_desc_label_2",
            "label": "Card 2nd description title",
            "default": "Session"
          }, {
            "type": "text",
            "id": "tab_desc_2",
            "label": "Card 2nd description",
            "default": "10 min · 3–6×/week"
          }, {
            "type": "richtext",
            "id": "footer",
            "label": "Footer text",
            "default": "<p>Not sure where to start? We recommend Deep Renewal for general rejuvenation or Clarify if breakouts are your primary concern.</p>"
          }, {
            "type": "color",
            "id": "text_color",
            "label": "Text color",
            "default": "#171717"
          }, {
            "type": "color",
            "id": "dot_color",
            "label": "Dot color",
            "default": "#ff3d2e"
          }, {
            "type": "color",
            "id": "border_color",
            "label": "Border color",
            "default": "#f3c9c1"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "MitoGlow Tabs Section",
        "blocks": [
          {
            "type": "tab"
          }, {
            "type": "tab"
          }, {
            "type": "tab"
