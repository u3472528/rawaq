{%- liquid
  assign articles_per_page = section.settings.articles_per_page
-%}

<section class="main-blog page-width">
  <header class="blog__header">
    <h1>{{ blog.title }}</h1>
  </header>

  {%- paginate blog.articles by articles_per_page -%}
    {%- if blog.articles.size > 0 -%}
      <ul class="blog-list">
        {%- for article in blog.articles -%}
          <li class="blog-list__item">
            <a href="{{ article.url }}" class="article-card">
              <span class="article-card__date">{{ article.published_at | date: '%B %d, %Y' }}</span>
              <span class="article-card__title">{{ article.title }}</span>
              {%- if section.settings.show_excerpt and article.excerpt != blank -%}
                <span class="article-card__excerpt">{{ article.excerpt | strip_html | truncate: 160 }}</span>
              {%- endif -%}
            </a>
          </li>
        {%- endfor -%}
      </ul>

      {%- if paginate.pages > 1 -%}
        <nav class="pagination">
          {%- if paginate.previous -%}
            <a class="pagination__link" href="{{ paginate.previous.url }}">{{ 'general.pagination.previous' | t }}</a>
          {%- endif -%}
          <span class="pagination__current">{{ 'general.pagination.page' | t: number: paginate.current_page, count: paginate.pages }}</span>
          {%- if paginate.next -%}
            <a class="pagination__link" href="{{ paginate.next.url }}">{{ 'general.pagination.next' | t }}</a>
          {%- endif -%}
        </nav>
      {%- endif -%}
    {%- else -%}
      <p class="blog__empty">{{ 'blogs.general.no_articles' | t }}</p>
    {%- endif -%}
  {%- endpaginate -%}
</section>

{% schema %}
{
  "name": "Blog",
  "settings": [
    {
      "type": "range",
      "id": "articles_per_page",
      "label": "Articles per page",
      "min": 4,
      "max": 24,
      "step": 2,
      "default": 10
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt",
      "default": true
    }
  ]
}
{% endschema %}