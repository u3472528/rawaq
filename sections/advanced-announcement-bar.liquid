{%- assign links = section.settings.links -%}

<div
  class="ad-announcement-bar ad-announcement-bar-{{ section.id }}"
  style="
    --bg: {{ section.settings.bg }};
    --text: {{ section.settings.text_color }};
    --padd_vertical: {{ section.settings.padd_vertical }}px;
    --padd_horizontal: {{ section.settings.padd_horizontal }}px;
    --font-size: {{ section.settings.font_size }}px;
  "
>
  <div class="ad-announcement-inner">
    {%- if links != blank -%}
      <nav class="links" aria-label="Announcement navigation">
        <ul>
          {%- for link in links.links -%}
            <li>
              <a href="{{ link.url }}">{{ link.title | escape }}</a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    <div class="announcements" aria-live="polite">
      {%- assign announcement_count = 0 -%}

      {%- for block in section.blocks -%}
        {%- if block.type == 'announcement' -%}
          <div
            class="announcement{% if announcement_count == 0 %} is-active{% endif %}"
            data-announcement
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.text_url != blank -%}
              <a href="{{ block.settings.text_url }}">
                {{ block.settings.text | escape }}
              </a>
            {%- else -%}
              <span>{{ block.settings.text | escape }}</span>
            {%- endif -%}
          </div>

          {%- assign announcement_count = announcement_count | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if announcement_count == 0 -%}
        <div class="announcement is-active">
          <span>Add an announcement in the theme editor.</span>
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.social_icons == 'show' -%}
      <div class="social-links">
        {%- if settings.facebook_link != blank -%}
          <a href="{{ settings.facebook_link }}" aria-label="Facebook">
            {{ 'facebook.svg' | inline_asset_content }}
            <span class="social_media_label hidden">Facebook</span>
          </a>
        {%- endif -%}

        {%- if settings.instagram_link != blank -%}
          <a href="{{ settings.instagram_link }}" aria-label="Instagram">
            {{ 'facebook.svg' | inline_asset_content }}
            <span class="social_media_label hidden">Instagram</span>
          </a>
        {%- endif -%}

        {%- if settings.tiktok_link != blank -%}
          <a href="{{ settings.tiktok_link }}" aria-label="TikTok">
            {{ 'facebook.svg' | inline_asset_content }}
            <span class="social_media_label hidden">TikTok</span>
          </a>
        {%- endif -%}

        {%- if settings.youtube_link != blank -%}
          <a href="{{ settings.youtube_link }}" aria-label="YouTube">
            {{ 'facebook.svg' | inline_asset_content }}
            <span class="social_media_label hidden">YouTube</span>
          </a>
        {%- endif -%}
        {%- if settings.pinterest_link != blank -%}
          <a href="{{ settings.pinterest_link }}" aria-label="YouTube">
            {{ 'pinterest.svg' | inline_asset_content }}
            <span class="social_media_label hidden">Pinterest</span>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

<style>
  .ad-announcement-bar-{{ section.id }} {
    background: var(--bg);
    color: var(--text);
    padding: var(--padd_vertical) var(--padd_horizontal);
    font-size: var(--font-size);
    width: 100%;
    box-sizing: border-box;
  }

  .ad-announcement-bar-{{ section.id }} .ad-announcement-inner {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .ad-announcement-bar-{{ section.id }} .links {
    flex: 0 0 auto;
  }

  .ad-announcement-bar-{{ section.id }} .links ul {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ad-announcement-bar-{{ section.id }} a {
    color: var(--text);
    text-decoration: none;
  }

  .ad-announcement-bar-{{ section.id }} .links a,
  .ad-announcement-bar-{{ section.id }} .social-links a {
    transition: opacity 0.2s ease;
  }

  .ad-announcement-bar-{{ section.id }} .links a:hover,
  .ad-announcement-bar-{{ section.id }} .social-links a:hover {
    opacity: 0.7;
  }

  .ad-announcement-bar-{{ section.id }} .announcements {
    flex: 1 1 auto;
    min-width: 0;
    text-align: center;
    position: relative;
  }

  .ad-announcement-bar-{{ section.id }} .announcement {
    display: none;
    width: 100%;
    overflow-wrap: anywhere;
  }

  .ad-announcement-bar-{{ section.id }} .announcement.is-active {
    display: block;
  }

  .ad-announcement-bar-{{ section.id }} .announcement a:hover {
    text-decoration: underline;
  }

  .ad-announcement-bar-{{ section.id }} .social-links {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex: 0 0 auto;
    gap: 12px;
  }

  @media screen and (max-width: 749px) {
    .ad-announcement-bar-{{ section.id }} {
      --font-size: {{ section.settings.mobile_font_size }}px;
    }

    .ad-announcement-bar-{{ section.id }} .ad-announcement-inner {
      flex-direction: column;
      gap: 8px;
    }

    .ad-announcement-bar-{{ section.id }} .links {
      width: 100%;
    }

    .ad-announcement-bar-{{ section.id }} .links ul {
      justify-content: center;
      gap: 8px 15px;
    }

    .ad-announcement-bar-{{ section.id }} .announcements {
      width: 100%;
      flex: auto;
    }

    .ad-announcement-bar-{{ section.id }} .social-links {
      justify-content: center;
      flex-wrap: wrap;
    }
  }
</style>

<script>
  (function () {
    var sectionId = '{{ section.id }}';
    var selector = '.ad-announcement-bar-' + sectionId;

    function initAnnouncementBar() {
      var bars = document.querySelectorAll(selector);

      bars.forEach(function (bar) {
        if (bar.dataset.sliderInitialized === 'true') return;

        var announcements = bar.querySelectorAll('[data-announcement]');

        if (!announcements.length) return;

        bar.dataset.sliderInitialized = 'true';

        var current = 0;

        announcements.forEach(function (announcement, index) {
          announcement.classList.toggle('is-active', index === 0);
        });

        if (announcements.length <= 1) return;

        window.setInterval(function () {
          if (!bar.isConnected) return;

          announcements[current].classList.remove('is-active');

          current = (current + 1) % announcements.length;

          announcements[current].classList.add('is-active');
        }, 4000);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAnnouncementBar);
    } else {
      initAnnouncementBar();
    }

    document.addEventListener('shopify:section:load', initAnnouncementBar);
  })();
</script>

{% schema %}
{
  "name": "Advance Announcement",
  "settings": [
    {
      "type": "header",
      "content": "Links and Social Media"
    },
    {
      "type": "link_list",
      "id": "links",
      "label": "Navigation links"
    },
    {
      "type": "select",
      "id": "social_icons",
      "label": "Social links",
      "options": [
        {
          "value": "hide",
          "label": "Hide"
        },
        {
          "value": "show",
          "label": "Show"
        }
      ],
      "default": "hide"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#222222"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Desktop font size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "mobile_font_size",
      "label": "Mobile font size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padd_vertical",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Vertical padding",
      "default": 10
    },
    {
      "type": "range",
      "id": "padd_horizontal",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Horizontal padding",
      "default": 10
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Announcement text",
          "default": "Welcome to our store"
        },
        {
          "type": "url",
          "id": "text_url",
          "label": "Announcement link"
        }
      ]
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "presets": [
    {
      "name": "Advance Announcement",
      "blocks": [
        {
          "type": "announcement"
        },
        {
          "type": "announcement",
          "settings": {
            "text": "Discover our latest collection"
          }
        }
      ]
    }
  ]
}
{% endschema %}
