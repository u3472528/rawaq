<section class="main-cart page-width">
  <h1 class="main-cart__title">{{ 'general.cart.title' | t }}</h1>

  {%- if cart.item_count > 0 -%}
    <form action="{{ routes.cart_url }}" method="post" class="cart-form">
      <div class="cart-items">
        <table>
          <thead>
            <tr>
              <th scope="col">{{ 'general.cart.product' | t }}</th>
              <th scope="col">{{ 'general.cart.quantity' | t }}</th>
              <th scope="col">{{ 'general.cart.total' | t }}</th>
              <th scope="col"></th>
            </tr>
          </thead>
          <tbody>
            {%- for item in cart.items -%}
              <tr class="cart-item">
                <td class="cart-item__product">
                  {%- if item.image -%}
                    <a href="{{ item.url }}" class="cart-item__image">
                      {{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 240', alt: item.image.alt | default: item.product.title }}
                    </a>
                  {%- endif -%}
                  <div class="cart-item__info">
                    <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>
                    {%- unless item.product.has_only_default_variant -%}
                      <p class="cart-item__variant">{{ item.variant.title }}</p>
                    {%- endunless -%}
                    <p class="cart-item__price">{{ item.final_price | money }}</p>
                  </div>
                </td>
                <td class="cart-item__quantity">
                  <input
                    type="number"
                    name="updates[]"
                    value="{{ item.quantity }}"
                    min="0"
                    aria-label="{{ 'general.cart.quantity' | t }}"
                  >
                </td>
                <td class="cart-item__total">{{ item.final_line_price | money }}</td>
                <td class="cart-item__remove">
                  <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0">
                    {{ 'general.cart.remove' | t }}
                  </a>
                </td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>

      <div class="cart-form__footer">
        <p class="cart-form__subtotal">
          {{ 'general.cart.subtotal' | t }}: {{ cart.total_price | money }}
        </p>
        <p class="cart-form__note">{{ 'general.cart.taxes_and_shipping_at_checkout' | t }}</p>
        <div class="cart-form__actions">
          <button type="submit" name="update" class="button button--secondary">{{ 'general.cart.update' | t }}</button>
          <button type="submit" name="checkout" class="button">{{ 'general.cart.checkout' | t }}</button>
        </div>
      </div>
    </form>
  {%- else -%}
    <div class="main-cart__empty">
      <p>{{ 'general.cart.empty' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="button">{{ 'general.cart.continue_shopping' | t }}</a>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Cart",
  "settings": []
}
{% endschema %}