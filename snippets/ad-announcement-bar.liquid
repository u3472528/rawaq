{% liquid
  assign type = block.settings.ann_type

  case type
    when 'announcement'
      assign content_text = block.settings.announcement_text
      assign content_url = block.settings.announcement_link

    when 'link'
      assign content_text = block.settings.link_text
      assign content_url = block.settings.link_url

    when 'social_link'
      assign content_text = block.settings.social_text
      assign content_url = block.settings.social_url
  endcase
%}

<section
  id="AnnouncementComponent-{{ block.id }}"
  class="announcement-component"
  data-section-id="{{ block.id }}"
  data-enable-close="{{ block.settings.enable_close }}"
  style="
    --announcement-bg: {{ block.settings.background_color }};
    --announcement-color: {{ block.settings.text_color }};
  "
  aria-label="Announcement"
>
  <div class="announcement-component__inner">

    <div class="announcement-component__content">

      {% if content_url != blank %}
        <a
          class="announcement-component__link"
          href="{{ content_url }}"
          {% if type == 'social_link' %}
            target="_blank"
            rel="noopener noreferrer"
          {% endif %}
        >
          {% if type == 'social_link' %}
            <span class="announcement-component__social-icon" aria-hidden="true">
              {% case block.settings.social_platform %}
                {% when 'facebook' %}
                  f
                {% when 'instagram' %}
                  ◎
                {% when 'twitter' %}
                  𝕏
                {% when 'youtube' %}
                  ▶
                {% when 'tiktok' %}
                  ♪
                {% when 'pinterest' %}
                  p
                {% when 'linkedin' %}
                  in
              {% endcase %}
            </span>
          {% endif %}

          <span class="announcement-component__text">
            {{ content_text | escape }}
          </span>
        </a>
      {% else %}
        <span class="announcement-component__text">
          {{ content_text | escape }}
        </span>
      {% endif %}

    </div>
  </div>
</section>

<style>
  #AnnouncementComponent-{{ block.id }} {
    --announcement-bg: {{ block.settings.background_color }};
    --announcement-color: {{ block.settings.text_color }};

    position: relative;
    z-index: 10;
    width: 100%;
    background-color: var(--announcement-bg);
    color: var(--announcement-color);
  }

  #AnnouncementComponent-{{ block.id }} .announcement-component__inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 44px;
    padding: 10px 48px;
  }

  #AnnouncementComponent-{{ block.id }} .announcement-component__content {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    text-align: center;
  }

  #AnnouncementComponent-{{ block.id }} .announcement-component__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: inherit;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  #AnnouncementComponent-{{ block.id }} .announcement-component__link:hover {
    opacity: 0.8;
  }

  #AnnouncementComponent-{{ block.id }} .announcement-component__text {
    margin: 0;
    font-size: 14px;
    line-height: 1.4;
    font-weight: 500;
    color: inherit;
  }

  #AnnouncementComponent-{{ block.id }} .announcement-component__social-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    font-size: 15px;
    line-height: 1;
    font-weight: 600;
  }

  #AnnouncementComponent-{{ block.id }} .announcement-component__close {
    position: absolute;
    top: 50%;
    right: 16px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: inherit;
    cursor: pointer;
    transform: translateY(-50%);
    transition:
      background-color 0.2s ease,
      opacity 0.2s ease;
  }

  #AnnouncementComponent-{{ block.id }} .announcement-component__close:hover {
    background-color: rgba(255, 255, 255, 0.12);
  }

  #AnnouncementComponent-{{ block.id }} .announcement-component__close:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  #AnnouncementComponent-{{ block.id }}.is-hidden {
    display: none;
  }

  @media screen and (max-width: 749px) {
    #AnnouncementComponent-{{ block.id }} .announcement-component__inner {
      min-height: 42px;
      padding: 9px 48px 9px 16px;
    }

    #AnnouncementComponent-{{ block.id }} .announcement-component__text {
      font-size: 13px;
    }

    #AnnouncementComponent-{{ block.id }} .announcement-component__close {
      right: 8px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #AnnouncementComponent-{{ block.id }} .announcement-component__link,
    #AnnouncementComponent-{{ block.id }} .announcement-component__close {
      transition: none;
    }
  }
</style>
