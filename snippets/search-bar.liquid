{{ 'search-bar.css' | asset_url | stylesheet_tag }}
{% assign placeholder = settings.search_bar_placeholder %}

<div style="--bg:#ededed;--inputs-radius:{{ settings.search_bar_corners }}px;" class="global-search">
  <input
    id="SearchBar"
    class="search-bar"
    type="search"
    value=""
    placeholder="{{ placeholder | default: 'What are you looking for?' }}"
    data-search-bar-data
  />
   <span class="search-icon">
  {{ 'search-icon.svg'  | inline_asset_content }}
   </span>
</div>
